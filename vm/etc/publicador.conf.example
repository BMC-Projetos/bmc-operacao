# /etc/bmc-publicador/publicador.conf  (root:root 0640)
# Copie para publicador.conf e ajuste. Sem segredo aqui: os segredos ficam em
# arquivos separados em /etc/bmc-publicador/segredos/ (root:root 0600).

# Repositório de operação (estado desejado de produção) e branch protegida
REPO_OPERACAO=ORG/bmc-operacao
BRANCH_OPERACAO=main

# GitHub App "bmc-publicador" (HMG-01 e AGENT-01): Contents read, Checks read,
# Commit statuses read/write. Instalado nos 6 repos de portal + bmc-operacao.
GITHUB_APP_ID=
GITHUB_APP_INSTALACAO=
GITHUB_APP_CHAVE=/etc/bmc-publicador/segredos/github-app.pem

# GitHub App "bmc-promotor" (SÓ na HMG-01): Contents read/write + Pull
# requests read/write, instalado SÓ no bmc-operacao. Abre o PR de promoção.
PROMOTOR_APP_ID=
PROMOTOR_APP_INSTALACAO=
PROMOTOR_APP_CHAVE=/etc/bmc-publicador/segredos/promotor-app.pem

# Registro interno (na HMG-01). REGISTRO_PUBLICO = nome que a PRODUÇÃO usa
# para baixar (vai no IMAGEM= do PR). Na AGENT-01: usuário e senha de leitura.
REGISTRO_PUBLICO=registro-hmg.bmchyundai.com.br:5443
REGISTRO_USUARIO=
REGISTRO_SENHA_ARQUIVO=/etc/bmc-publicador/segredos/registro.senha

# Só se um dia usar o GHCR (plano pago): conta de máquina + PAT read:packages
GHCR_USUARIO=
GHCR_TOKEN_ARQUIVO=/etc/bmc-publicador/segredos/ghcr.token

# Métricas (o mesmo Pushgateway do cockpit-docker-stats). Vazio = não envia.
PUSHGATEWAY_URL=http://10.0.0.120:9091

# Não publica (nem monta) se a raiz do Docker tiver menos que isso livre
DISCO_MIN_LIVRE_MB=3072
# Imagens antigas mantidas por serviço, além da atual e da anterior
MANTER_IMAGENS=3
