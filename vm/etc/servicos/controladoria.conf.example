# /etc/bmc-publicador/servicos/controladoria.conf  (root:root 0640)
# Um arquivo por serviço e ambiente. O nome do arquivo (sem .conf) é o <id>.
SERVICO=controladoria                # pasta servicos/<SERVICO>/ no bmc-operacao
AMBIENTE=producao                    # producao: digest do Git | homologacao: segue a tag
IMAGEM_REPO=ghcr.io/ORG/controladoria   # minúsculas; só imagens deste repositório são aceitas

COMPOSE_DIR=/srv/bmc/controladoria   # compose.yml (TI) + .env (publicador)
COMPOSE_SERVICO=app                  # nome do serviço dentro do compose.yml
CONTAINER=conciliacao-bmc            # mesmo nome de hoje: monitoramento não muda

# Endpoint que responde 2xx quando a aplicação está pronta. Em 2026-11-16:
# "/" = 200 sem login; /api/health = 401 (exige sessão). O smoke confere a API.
HEALTH_URL=http://127.0.0.1:3000/
HEALTH_TIMEOUT=120

# Opcional: script local (TI) chamado com o HEALTH_URL; saída != 0 = falha
SMOKE=/etc/bmc-publicador/smoke/controladoria.sh

# Lock do instalador antigo (ZIP): os dois nunca rodam juntos.
# Confirmado em 2026-11-16: instalar.py faz fcntl.flock(LOCK_EX|LOCK_NB) nele.
LOCK_EXTRA=/home/plataforma-conciliacao/operacao/atualizacao.lock
