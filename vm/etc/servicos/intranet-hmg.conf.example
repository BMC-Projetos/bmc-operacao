# /etc/bmc-publicador/servicos/intranet-hmg.conf: HOMOLOGAÇÃO na BMC-HMG-01.
# MONTA a imagem de cada commit da main que passou no CI (registro local),
# publica aqui e, se ficar saudável, abre o PR de promoção no bmc-operacao.
SERVICO=intranet
AMBIENTE=homologacao
MODO=build
REPO_APP=ORG/intranet
BRANCH_APP=main
CHECK_CI=imagem               # job do pipeline que precisa ter passado
PROMOVER=sim                  # abre/atualiza o PR de produção
#FONTE_LOCAL=/srv/bmc/git/intranet.git   # teste sem GitHub (repositório local)
IMAGEM_REPO=127.0.0.1:5000/intranet
COMPOSE_DIR=/srv/bmc/intranet-hmg
COMPOSE_SERVICO="app"
CONTAINER="bmc-intranet-hmg"
HEALTH_URL=http://127.0.0.1:13003/health
HEALTH_TIMEOUT=120
SMOKE=
LOCK_EXTRA=
