# /etc/bmc-publicador/servicos/agentes-hmg.conf: HOMOLOGAÇÃO na BMC-HMG-01.
# MONTA a imagem de cada commit da main que passou no CI (registro local),
# publica aqui e, se ficar saudável, abre o PR de promoção no bmc-operacao.
SERVICO=agentes-fiscal
AMBIENTE=homologacao
MODO=build
REPO_APP=ORG/agentes-fiscal
BRANCH_APP=main
CHECK_CI=imagem               # job do pipeline que precisa ter passado
PROMOVER=sim                  # abre/atualiza o PR de produção
#FONTE_LOCAL=/srv/bmc/git/agentes-fiscal.git   # teste sem GitHub (repositório local)
IMAGEM_REPO=127.0.0.1:5000/agentes-fiscal
COMPOSE_DIR=/srv/bmc/agentes-hmg
COMPOSE_SERVICO="painel webhook"
CONTAINER="agentes-fiscal-painel-hmg agentes-fiscal-webhook-hmg"
HEALTH_URL=http://127.0.0.1:18503/_stcore/health
HEALTH_TIMEOUT=120
SMOKE=
LOCK_EXTRA=
