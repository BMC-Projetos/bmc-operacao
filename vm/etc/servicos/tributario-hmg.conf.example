# /etc/bmc-publicador/servicos/tributario-hmg.conf: HOMOLOGAÇÃO na BMC-HMG-01.
# MONTA a imagem de cada commit da main que passou no CI (registro local),
# publica aqui e, se ficar saudável, abre o PR de promoção no bmc-operacao.
SERVICO=portal-tributario
AMBIENTE=homologacao
MODO=build
REPO_APP=ORG/portal-tributario
BRANCH_APP=main
CHECK_CI=imagem               # job do pipeline que precisa ter passado
PROMOVER=sim                  # abre/atualiza o PR de produção
#FONTE_LOCAL=/srv/bmc/git/portal-tributario.git   # teste sem GitHub (repositório local)
IMAGEM_REPO=127.0.0.1:5000/portal-tributario
COMPOSE_DIR=/srv/bmc/tributario-hmg
COMPOSE_SERVICO="app"
CONTAINER="portaltributario-hmg"
HEALTH_URL=http://127.0.0.1:18501/_stcore/health
HEALTH_TIMEOUT=120
SMOKE=
LOCK_EXTRA=
