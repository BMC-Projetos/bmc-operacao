# /etc/bmc-publicador/servicos/controladoria-hmg.conf: HOMOLOGAÇÃO na BMC-HMG-01.
# MONTA a imagem de cada commit da main que passou no CI (registro local),
# publica aqui e, se ficar saudável, abre o PR de promoção no bmc-operacao.
SERVICO=controladoria
AMBIENTE=homologacao
MODO=build
REPO_APP=ORG/controladoria
BRANCH_APP=main
CHECK_CI=imagem               # job do pipeline que precisa ter passado
PROMOVER=sim                  # abre/atualiza o PR de produção
#FONTE_LOCAL=/srv/bmc/git/controladoria.git   # teste sem GitHub (repositório local)
IMAGEM_REPO=127.0.0.1:5000/controladoria
COMPOSE_DIR=/srv/bmc/controladoria-hmg
COMPOSE_SERVICO="app"
CONTAINER="conciliacao-bmc-hmg"
HEALTH_URL=http://127.0.0.1:13000/
HEALTH_TIMEOUT=120
SMOKE=/etc/bmc-publicador/smoke/controladoria.sh
LOCK_EXTRA=
