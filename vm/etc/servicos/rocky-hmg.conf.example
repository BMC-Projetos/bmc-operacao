# /etc/bmc-publicador/servicos/rocky-hmg.conf: HOMOLOGAÇÃO na BMC-HMG-01.
# MONTA a imagem de cada commit da main que passou no CI (registro local),
# publica aqui e, se ficar saudável, abre o PR de promoção no bmc-operacao.
SERVICO=rocky-agent
AMBIENTE=homologacao
MODO=build
REPO_APP=ORG/rocky-agent
BRANCH_APP=main
CHECK_CI=imagem               # job do pipeline que precisa ter passado
PROMOVER=sim                  # abre/atualiza o PR de produção
#FONTE_LOCAL=/srv/bmc/git/rocky-agent.git   # teste sem GitHub (repositório local)
IMAGEM_REPO=127.0.0.1:5000/rocky-agent
COMPOSE_DIR=/srv/bmc/rocky-hmg
COMPOSE_SERVICO="app"
CONTAINER="rocky-agent-hmg"
HEALTH_URL=http://127.0.0.1:13002/health
HEALTH_TIMEOUT=120
SMOKE=
LOCK_EXTRA=
