# abre o PR. O merge (aprovado pelo dono) faz o bmc-publicador aplicar em ~2 min.
# Formato rígido, conferido pelo check "valida" e pelo publicador:
#   IMAGEM=ghcr.io/<org>/controladoria@sha256:<64 hex>
IMAGEM=
